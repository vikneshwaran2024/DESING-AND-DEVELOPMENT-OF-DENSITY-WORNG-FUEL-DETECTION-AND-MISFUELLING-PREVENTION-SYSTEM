% Wrong Fuel Detection and Misfuelling Prevention System
% MATLAB/Simulink R2021a compatible model builder
% Run this script in MATLAB R2021a. It creates the .slx model, runs three
% example scenarios, plots the outputs, and saves a results MAT file.
% NOTE: Inputs are illustrative simulation values, not real sensor data.
% Calibrate thresholds using actual samples before any hardware use.
clear; clc; close all;
model = 'WrongFuel_Density_RGB_R2021a';
if bdIsLoaded(model), close_system(model, 0); end 
if exist([model '.slx'],'file'), delete([model '.slx']); end 
new_system(model);
open_system(model);
set_param(model, 'StopTime','10', 'Solver','FixedStepDiscrete', ... 
'FixedStep','0.1', 'SaveTime','on', 'SignalLogging','on');
% Layout positions
add_block('simulink/Sources/Constant',[model '/Density_kg_m3'], ... 
'Value','740','Position',[35 45 105 75]);
add_block('simulink/Sources/Constant',[model '/Red_R'], ... 
'Value','210','Position',[35 105 105 135]);
37
add_block('simulink/Sinks/Scope',[model '/Buzzer_Scope'], ... 
'Position',[920 190 990 230]);
add_block('simulink/Sinks/Scope',[model '/Drain_Valve_Scope'], ... 
'Position',[920 285 990 325]);
% Optional input scope to inspect Density, R, G, and B together 
add_block('simulink/Signal Routing/Mux',[model '/Input_Mux'], ...
'Inputs','4','Position',[150 430 155 510]); 
add_block('simulink/Sinks/Scope',[model '/Density_RGB_Input_Scope'], ...
'Position',[225 430 300 490]);
% Combined output scope retained for convenience 
add_block('simulink/Signal Routing/Mux',[model '/Output_Mux'], ...
'Inputs','3','Position',[790 390 795 455]); 
add_block('simulink/Sinks/Scope',[model '/Output_Scope'], ...
'Position',[855 385 925 455]);
% Wiring: inputs to comparators 
add_line(model,'Density_kg_m3/1','Density_Min_Check/1'); 
add_line(model,'Density_kg_m3/1','Density_Max_Check/1');
add_line(model,'Red_R/1','Red_Min_Check/1'); 
add_line(model,'Red_R/1','Red_Max_Check/1');
38
add_block('simulink/Logic and Bit Operations/Compare To Constant',[model 
'/Green_Min_Check'], ...
'const','180','relop','>=','Position',[155 215 255 245]);
add_block('simulink/Logic and Bit Operations/Compare To Constant',[model 
'/Green_Max_Check'], ...
'const','190','relop','<=','Position',[155 260 255 290]);
add_block('simulink/Logic and Bit Operations/Compare To Constant',[model 
'/Blue_Min_Check'], ...
'const','120','relop','>=','Position',[155 305 255 335]);
add_block('simulink/Logic and Bit Operations/Compare To Constant',[model 
'/Blue_Max_Check'], ...
'const','135','relop','<=','Position',[155 350 255 380]);
% AND gates: pair each min/max range, then all checks 
pairs = {'Density_Range_OK', [315 50 365 85]; ...
'Red_Range_OK', [315 145 365 180]; ...
'Green_Range_OK', [315 235 365 270]; ...
'Blue_Range_OK', [315 325 365 360]};
for k=1:size(pairs,1) 
nm=pairs{k,1}; pos=pairs{k,2};
add_block('simulink/Logic and Bit Operations/Logical Operator',[model '/' nm], ... 
'Operator','AND','Inputs','2','Position',pos);
end
